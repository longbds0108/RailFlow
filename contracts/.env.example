# Copy to .env and fill in. Never commit the real .env (already gitignored).

# Dedicated testnet wallet only — needs Arc Testnet USDC for gas.
DEPLOYER_PRIVATE_KEY=

ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# Real Arc Testnet token addresses (defaults in deploy-lending.js match these).
CIRBTC_ADDRESS=0xf0C4a4CE82A5746AbAAd9425360Ab04fbBA432BF
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Illustrative cirBTC price in USDC (no oracle on testnet — see contract dev note).
COLLATERAL_PRICE=65000

# Optional: seed the pool with this much USDC right after deploy (deployer
# wallet must hold it). Leave unset to skip and fund later via fundPool().
FUND_AMOUNT=
